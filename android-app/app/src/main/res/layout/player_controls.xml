<?xml version="1.0" encoding="utf-8"?>
<!-- Contrôles ExoPlayer personnalisés — barre du bas uniquement -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="#CC000000"
    android:padding="12dp">

    <!-- Barre de progression -->
    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginBottom="4dp" />

    <!-- Boutons + temps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Bouton précédent -->
        <ImageButton
            android:id="@id/exo_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/exo_ic_skip_previous"
            android:tint="#FFFFFF"
            android:contentDescription="Précédent" />

        <!-- Rewind 10s -->
        <ImageButton
            android:id="@id/exo_rew"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/exo_ic_rewind"
            android:tint="#FFFFFF"
            android:contentDescription="-10s" />

        <!-- Play / Pause -->
        <ImageButton
            android:id="@id/exo_play_pause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="Lecture/Pause" />

        <!-- Forward 10s -->
        <ImageButton
            android:id="@id/exo_ffwd"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/exo_ic_fast_forward"
            android:tint="#FFFFFF"
            android:contentDescription="+10s" />

        <!-- Bouton suivant -->
        <ImageButton
            android:id="@id/exo_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/exo_ic_skip_next"
            android:tint="#FFFFFF"
            android:contentDescription="Suivant" />

        <!-- Temps position / durée -->
        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" / "
            android:textColor="#90B8D8"
            android:textSize="12sp" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#90B8D8"
            android:textSize="12sp" />

    </LinearLayout>
</LinearLayout>
